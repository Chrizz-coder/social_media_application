DATABASE_URL=mongodb://localhost:27017/social_platform
REDIS_URL=redis://localhost:6379
JWT_SECRET=changeme_use_a_real_secret_in_production
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql

# Auth.js Secrets
AUTH_SECRET=placeholder_secret_replace_in_production
AUTH_GITHUB_ID=github_client_id_here
AUTH_GITHUB_SECRET=github_client_secret_here
AUTH_GOOGLE_ID=google_client_id_here
AUTH_GOOGLE_SECRET=google_client_secret_here

# Neo4j — local development (Docker)
# To migrate to Neo4j AuraDB, replace NEO4J_URI with your AuraDB connection
# string and update NEO4J_USERNAME / NEO4J_PASSWORD accordingly.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=devpassword123!
